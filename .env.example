# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# https://home.openweathermap.org/api_keys (free tier). Weather and country data need it.
OPENWEATHER_API_KEY=
# https://restcountries.com API key (Bearer token). The ETL caches the country list in Postgres and
# refreshes it weekly (~15 requests/month). Without it the bundled etl_app/src/countries.json is used.
RESTCOUNTRIES_API_KEY=
# Mapbox public token (pk.*). Optional: the map uses OpenStreetMap/CARTO tiles without it.
MAPBOX_API_KEY=

# Database password: required, docker compose refuses to start without it. Use a long random
# value (openssl rand -hex 24). It only takes effect when the volume is first created.
POSTGRES_PASSWORD=

# Optional overrides (host ports are bound to 127.0.0.1)
# WEB_HOST_PORT=5000
# POSTGRES_HOST_PORT=5435
# COLLECT_CRON=* * * * *
# CLEANUP_CRON=0 * * * *
# RETENTION_HOURS=24
# COUNTRIES_CRON=0 3 * * *
# COUNTRIES_MAX_AGE_DAYS=7
